{
  "claude-code": {
    "label": "Claude Code (Claude Pro/Max login)",
    "command": "claude",
    "args": [
      "-p",
      "{modelArgs}",
      "--output-format",
      "text",
      "--disallowedTools",
      "*",
      "--no-session-persistence",
      "--system-prompt-file",
      "{systemFile}"
    ],
    "modelArgs": [
      "--model",
      "{model}"
    ],
    "stdin": "{prompt}",
    "loginHint": "Run \"claude\" once in a terminal and log in with your Claude account.",
    "models": [
      {
        "id": "",
        "label": "Default of your Claude Code setup"
      },
      {
        "id": "fable",
        "label": "fable (latest Fable, most capable)"
      },
      {
        "id": "opus",
        "label": "opus (latest Opus)"
      },
      {
        "id": "sonnet",
        "label": "sonnet (latest Sonnet)"
      },
      {
        "id": "haiku",
        "label": "haiku (latest Haiku, fastest)"
      },
      {
        "id": "claude-fable-5-1",
        "label": "Claude Fable 5.1"
      },
      {
        "id": "claude-opus-5-5",
        "label": "Claude Opus 5.5"
      },
      {
        "id": "claude-sonnet-5-5",
        "label": "Claude Sonnet 5.5"
      },
      {
        "id": "claude-haiku-4-5",
        "label": "Claude Haiku 4.5"
      }
    ]
  },
  "codex": {
    "label": "OpenAI Codex CLI (ChatGPT login)",
    "command": "codex",
    "args": [
      "exec",
      "{modelArgs}",
      "--skip-git-repo-check",
      "--sandbox",
      "read-only",
      "--ephemeral",
      "-"
    ],
    "modelArgs": [
      "-m",
      "{model}"
    ],
    "stdin": "{system}\n\n---\n\n{prompt}",
    "loginHint": "Run \"codex login\" once in a terminal and log in with your ChatGPT account.",
    "models": [
      {
        "id": "",
        "label": "Default of your Codex setup"
      },
      {
        "id": "gpt-6-astra",
        "label": "GPT-6-Astra (most capable)"
      },
      {
        "id": "gpt-6.1-sol",
        "label": "GPT-6.1-Sol (latest workhorse)"
      },
      {
        "id": "gpt-6-luna",
        "label": "GPT-6-Luna (fastest)"
      }
    ]
  },
  "gemini-cli": {
    "label": "Gemini CLI (needs a Gemini API key)",
    "command": "gemini",
    "args": [
      "{modelArgs}",
      "--skip-trust",
      "--approval-mode",
      "plan",
      "--output-format",
      "text",
      "-p",
      "Follow the instructions in the input."
    ],
    "modelArgs": [
      "-m",
      "{model}"
    ],
    "stdin": "{system}\n\n---\n\n{prompt}",
    "loginHint": "Google no longer accepts personal Google logins in Gemini CLI. Start the app with GEMINI_API_KEY set (e.g. GEMINI_API_KEY=... npm start).",
    "models": [
      {
        "id": "",
        "label": "Default of your Gemini CLI setup"
      },
      {
        "id": "auto",
        "label": "auto (Gemini CLI picks the model)"
      },
      {
        "id": "pro",
        "label": "pro (latest Pro, most capable)"
      },
      {
        "id": "flash",
        "label": "flash (latest Flash)"
      },
      {
        "id": "flash-lite",
        "label": "flash-lite (latest Flash-Lite, fastest)"
      }
    ]
  }
}
