{
  "name": "pseudonymizer",
  "productName": "Pseudonymizer",
  "version": "0.2.0",
  "private": true,
  "description": "Local pseudonymization of sensitive values before text is sent to an AI model",
  "type": "module",
  "main": "desktop/main.js",
  "desktopName": "pseudonymizer.desktop",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "electron .",
    "server": "node server/start.js",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:model": "node scripts/test-model.mjs",
    "check": "node scripts/check.mjs",
    "check:network": "node scripts/check-network.mjs",
    "build": "node scripts/build-app.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "onnxruntime-node": "1.31.1",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.1"
  }
}
